        'not null' => false,
      ),
      'div_plac' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => false,
        'default' => '',
      ),
      'parent1' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => false,
        'default' => '',
