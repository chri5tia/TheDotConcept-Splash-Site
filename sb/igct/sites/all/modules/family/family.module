/**
 * @todo Please document this function.
 * @see http://drupal.org/node/1354
 */
function family_individual_check_type($nid) {
  if (is_numeric($nid)) {
    $node = node_load($nid);
    if ($node->type == 'family_individual') {
      return TRUE;
    }
  }
  return FALSE;
}

