a:48:{s:9:"ext.title";s:10:"Login Page";s:10:"page.title";s:5:"Login";s:9:"tab.login";s:5:"Login";s:8:"tab.help";s:4:"Help";s:8:"tab.blog";s:4:"Blog";s:14:"loginbox.title";s:34:"Welcome! Enjoy working with todoyu";s:19:"form.field.username";s:9:"User Name";s:26:"form.field.usernameoremail";s:17:"User Name / Email";s:19:"form.field.password";s:8:"Password";s:17:"form.field.submit";s:5:"Login";s:16:"form.remainLogin";s:28:"Remember me on this computer";s:16:"form.loginFailed";s:59:"The user name or password is not correct. Please try again.";s:26:"form.status.enterLoginData";s:45:"Please enter your user name and your password";s:30:"form.status.verifyingLoginData";s:32:"Verifying user name and password";s:19:"form.status.loginOk";s:29:"Login OK. Now starting todoyu";s:23:"form.status.loginFailed";s:12:"Login Failed";s:19:"error.enterUsername";s:27:"Please enter your user name";s:19:"error.enterPassword";s:26:"Please enter your password";s:13:"headlet.label";s:6:"Logout";s:16:"warning.capslock";s:29:"Warning: caps lock key is on!";s:14:"forgotpassword";s:21:"Forgot your password?";s:22:"forgotpassword.tologin";s:34:"Click here to go to the login page";s:30:"forgotpassword.invalidusername";s:37:"The entered user name does not exist.";s:40:"forgotpassword.invalidusername.adminlink";s:30:"I cannot remember my user name";s:37:"forgotpassword.invalidusernameoremail";s:54:"The entered user name or email address does not exist.";s:32:"forgotpassword.form.field.submit";s:23:"Send me my new password";s:32:"forgotpassword.form.field.cancel";s:26:"Cancel and return to login";s:46:"forgotpassword.form.field.notification.success";s:56:"A confirmation mail has been sent to your email address.";s:33:"forgotpassword.form.field.comment";s:166:"You forgot your password? No problem! Enter your user name oder your email address and push the send button. You will receive an email to confirm your password reset.";s:39:"forgotpassword.mail.subject.newpassword";s:24:"Your new todoyu password";s:38:"forgotpassword.mail.confirmation.title";s:27:"Password reset confirmation";s:37:"forgotpassword.mail.confirmation.text";s:150:"You requested a new password. Please confirm your request by clicking the link below. The new password will be sent to your email address immediately.";s:39:"forgotpassword.mail.passwordreset.title";s:29:"Your password has been reset.";s:38:"forgotpassword.mail.passwordreset.text";s:214:"You will find your new password in this email. If you wish to change the password again, just log in to todoyu and go to the personal settings of your profile. In the password tab you can set your desired password.";s:27:"forgotpassword.mail.tologin";s:34:"Click here to go to the login page";s:34:"forgotpassword.mail.toconfirmation";s:33:"Click here to reset your password";s:35:"forgotpassword.mail.yournewpassword";s:24:"Your new todoyu password";s:32:"forgotpassword.mail.yourusername";s:14:"Your user name";s:43:"forgotpassword.confirmpage.successful.title";s:36:"Your password was successfully reset";s:42:"forgotpassword.confirmpage.successful.text";s:232:"Your password was successfully reset. The new password has been sent to your email address. If you wish to change the password again, just login and go to the personal settings. In the password tab you can set your desired password.";s:40:"forgotpassword.confirmpage.failure.title";s:20:"We are sorry but ...";s:39:"forgotpassword.confirmpage.failure.text";s:179:"... this link is no longer available. Your new password should have already been sent to your email address. If you wish further information please contact your %sAdministrator%e.";s:18:"loginexpired.title";s:22:"Your login has expired";s:20:"loginexpired.message";s:96:"Your login has expired. Please enter your account credentials in the following form to re-login.";s:20:"form.javascriptcheck";s:105:"JavaScript is deactivated in your browser. Please activate JavaScript in your browser settings to log in.";s:30:"form.javascriptcheck.linklabel";s:44:"How can I activate JavaScript in my browser?";s:16:"form.cookiecheck";s:98:"Cookies are deactivated in your browser. Please enable cookies in your browser settings to log-in.";s:26:"form.cookiecheck.linklabel";s:41:"How can I activate cookies in my browser?";}