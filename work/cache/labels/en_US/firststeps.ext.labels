a:44:{s:9:"ext.title";s:11:"First Steps";s:18:"wizard.start.title";s:26:"Your first steps in todoyu";s:17:"wizard.start.info";s:258:"This wizard guides you through the first steps in todoyu. The whole procedure will take only <strong>a few minutes</strong> of your valuable time. Afterwards you will have a ready to work installation. <br /><br />Please press the "continue" button to start.";s:17:"wizard.start.help";s:6:"&nbsp;";s:26:"wizard.start.dontUseWizard";s:59:"I don't want to use the wizard. Don't show this popup again";s:29:"wizard.start.disableAssistant";s:17:"Disable Assistant";s:30:"wizard.start.reactivateInAdmin";s:50:"You can re-enable this wizard in the admin section";s:21:"wizard.jobtypes.title";s:9:"Job Types";s:20:"wizard.jobtypes.info";s:127:"Please enter job types you usually use in your company and projects. You can change them any time in the administration section";s:20:"wizard.jobtypes.help";s:75:" Job types could be:<br />CEO, CFO, manager, team leader, secretary, sales ";s:25:"wizard.projectroles.title";s:13:"Project Roles";s:24:"wizard.projectroles.info";s:66:"Please fill in the project roles you usually have in your project.";s:24:"wizard.projectroles.help";s:216:" To give you an idea what this could be: In the todoyu team we have the following project roles:<br />project manager, developer, frontend engineer, product manager, marketing responsible, community manager, trainer ";s:23:"wizard.activities.title";s:10:"Activities";s:22:"wizard.activities.info";s:59:"Activities define the kind of work you assign to your team.";s:22:"wizard.activities.help";s:69:"Activities can be consulting, programming, support, internal work ...";s:22:"wizard.userroles.title";s:11:"User Groups";s:21:"wizard.userroles.info";s:131:"The user groups are used for administration purposes.You can assign rights to your user groups in the administration section later ";s:21:"wizard.userroles.help";s:136:"Quite often the user groups are bound to the job types you previously entered. But it is up to you to define as many groups as you want.";s:20:"wizard.company.title";s:12:"Your Company";s:19:"wizard.company.info";s:106:"Please enter the basic information of your company. You can change that any times in the contacts section.";s:19:"wizard.company.help";s:6:"&nbsp;";s:22:"wizard.employees.title";s:9:"Employees";s:21:"wizard.employees.info";s:141:"Now tell todoyu who your team members are. Define the basis personal information - the users can change their data any time in their profile.";s:21:"wizard.employees.help";s:6:"&nbsp;";s:30:"wizard.employees.confirmRemove";s:15:"Remove employee";s:22:"wizard.employees.added";s:30:"Employee was added to the list";s:22:"wizard.customers.title";s:9:"Customers";s:21:"wizard.customers.info";s:99:"Hopefully you already have some customers at this point. Great! Please enter the basic information.";s:21:"wizard.customers.help";s:6:"&nbsp;";s:30:"wizard.customers.confirmRemove";s:16:"Remove customer?";s:20:"wizard.project.title";s:13:"First Project";s:19:"wizard.project.info";s:71:"Finally, start with your very first project in todoyu. Congratulations!";s:19:"wizard.project.help";s:6:"&nbsp;";s:34:"wizard.project.confirmRemovePerson";s:36:"Remove assigned person from project?";s:19:"wizard.finish.title";s:10:"That's it!";s:18:"wizard.finish.info";s:132:"You now have <strong>successfully</strong> entered all the necessary information to work with todoyu smoothly.<br /><br /> Enjoy it!";s:18:"wizard.finish.help";s:6:"&nbsp;";s:25:"wizard.finish.closeWizard";s:12:"Close wizard";s:19:"employee.addCompany";s:11:"Add company";s:20:"employee.addEmployee";s:12:"Add employee";s:18:"employee.addPerson";s:21:"Add person to project";s:21:"extconf.disableWizard";s:21:"Deactivate the wizard";s:18:"wizardDisabledInfo";s:22:"Wizard is disabled now";}