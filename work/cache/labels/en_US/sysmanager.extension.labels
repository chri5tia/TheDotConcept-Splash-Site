licts with installed extensions";s:18:"install.error.core";s:24:"Core version is too low.";s:33:"install.error.core.atLeastVersion";s:26:"Required version at least:";s:9:"uninstall";s:19:"Uninstall Extension";s:17:"uninstall.confirm";s:20:"Uninstall Extension?";s:12:"uninstall.ok";s:38:"Extension was uninstalled successfully";s:25:"uninstall.cannotuninstall";s:26:"Cannot uninstall extension";s:36:"uninstall.thefollowingextdependsonit";s:38:"The following extensions depend on it:";s:23:"uninstall.error.general";s:34:"Uninstallation of extension failed";s:22:"uninstall.error.sysext";s:48:"is a system extension and cannot be uninstalled.";s:22:"uninstall.aftermessage";s:115:"The extension was uninstalled successfully. The extension is still available on the server, but not loaded anymore.";s:19:"notify.remove.error";s:29:"Removing the extension failed";s:21:"notify.remove.success";s:49:"The extension was sucessfully removed from server";s:17:"upload.selectfile";s:30:"Select extension archive (zip)";s:15:"upload.override";s:36:"Overwrite existing extension (files)";s:12:"upload.title";s:20:"Upload New Extension";s:13:"upload.button";s:16:"Upload Extension";s:24:"upload.noArchiveSelected";s:44:"Please select an extension archive to upload";s:9:"upload.ok";s:64:"The extension was successfully imported and can now be installed";s:12:"upload.error";s:23:"Extension Upload Failed";s:18:"upload.archivehint";s:116:"A todoyu extension archive has to be named correctly: todoyuExt_EXTNAME_VERSION.zip. Ex: todoyuExt_project_1.1.0.zip";}